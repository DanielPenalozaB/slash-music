# ================================
# SLASH MUSIC - Environment Variables Template
# ================================
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control

# ================================
# APPLICATION SETTINGS
# ================================
SPRING_APPLICATION_NAME=music
SERVER_PORT=8080

# ================================
# DATABASE CONFIGURATION (PostgreSQL)
# ================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=slash_db
POSTGRESQL_USER=slash_db_user
POSTGRESQL_PASSWORD=slash_db_password

# Full database URL (constructed from above)
POSTGRESQL_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# ================================
# JPA/HIBERNATE CONFIGURATION
# ================================
# Options: validate, update, create, create-drop, none
HIBERNATE_DDL_AUTO=validate
HIBERNATE_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=true

# ================================
# FLYWAY CONFIGURATION
# ================================
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0

# ================================
# JWT CONFIGURATION
# ================================
# IMPORTANT: Generate a strong secret key for production!
# Use at least 256 bits (32 characters) for HS256 algorithm
JWT_SECRET=mySecretKey123456789012345678901234567890
# Token expiration in milliseconds (default: 24 hours)
JWT_EXPIRATION=86400000
# Refresh token expiration in milliseconds (default: 7 days)
JWT_REFRESH_EXPIRATION=604800000

# ================================
# DOCKER COMPOSE VARIABLES
# ================================
# Used by docker-compose.yml
POSTGRES_DB=slash_db
POSTGRES_USER=slash_db_user
POSTGRES_PASSWORD=slash_db_password
POSTGRES_PORT=5432

# ================================
# ENVIRONMENT
# ================================
# Options: dev, staging, prod
ENVIRONMENT=dev